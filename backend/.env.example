# Copy to .env and fill in. Values here are examples only.
NODE_ENV=development
PORT=4000

# SQLite file. The folder is created on start.
DATABASE_PATH=./data/aura.db

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# 32 bytes as 64 hex characters, used to encrypt recorder passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Kitchen time zone. Used for "today", daily trend buckets, shift times and ISO offsets.
APP_TIMEZONE=Asia/Kolkata

# Public address of this API, used to build HLS stream URLs.
PUBLIC_BASE_URL=http://localhost:4000

# Set to true when running behind a reverse proxy (needed for correct rate limiting).
TRUST_PROXY=false

# RTSP to HLS conversion with ffmpeg. If ffmpeg is not found, streamUrl is null.
STREAMS_ENABLED=true
FFMPEG_PATH=ffmpeg
HLS_DIR=./data/hls

# Recorder discovery
RTSP_TIMEOUT_MS=4000
RTSP_MAX_CHANNELS=16

# Optional. Failed-check alerts are POSTed here as JSON, signed with HMAC-SHA256 in
# the X-Aura-Signature header when NOTIFY_WEBHOOK_SECRET is set. Point it at your SMS/email gateway.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
